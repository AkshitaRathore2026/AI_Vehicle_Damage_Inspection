# Copy this file to .env after PostgreSQL and Redis are available.
# Never commit the real .env file.

APP_NAME=AI Vehicle Damage Inspection System
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/vehicle_damage_inspection

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_URL=redis://localhost:6379/0

MODEL_PATH=ml/weights/best.pt
MODEL_NAME=vehicle-damage-yolo
MODEL_VERSION=0.1.0-poc
MODEL_CONFIDENCE_THRESHOLD=0.35
USE_MOCK_DETECTOR=true

UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
REPORT_DIR=storage/reports

MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png
